[Unit]
Description=GOST Tunnel Service
# 确保网络完全启动后再运行
After=network.target

[Service]
Type=simple
# 使用你提供的路径和参数
ExecStart=/usr/sbin/gost -L socks5://:10801 -L http://:18888
# on-failure: 只在异常退出时重启，正常停止时不重启（确保容器能正常关闭）
Restart=on-failure
# 避免疯狂重启，设置 5 秒间隔
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
